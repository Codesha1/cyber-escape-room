# رابط قاعدة البيانات من Supabase (Transaction pooler - المنفذ 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# كلمة مرور لوحة الإدارة /admin
ADMIN_PASSWORD=اكتبي-كلمة-مرور-قوية
# نص عشوائي طويل (32 حرفًا على الأقل) لتوقيع جلسات الإدارة
SESSION_SECRET=ضعي-هنا-نصا-عشوائيا-طويلا
